# Network — must match Anchor.toml [provider] cluster
NUXT_PUBLIC_SOLANA_NETWORK=devnet

# Solana RPC endpoint (use Helius/QuickNode if public devnet is rate-limited)
NUXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Deployed wibe_casino program ID — fill after: anchor deploy --provider.cluster devnet
NUXT_PUBLIC_CASINO_PROGRAM_ID=Wibe1111111111111111111111111111111111111

# SPL casino token mint on devnet — create via scripts or anchor test setup
NUXT_PUBLIC_CASINO_TOKEN_MINT=Token1111111111111111111111111111111111111

# Local Anchor wallet path — NEVER commit private keys
ANCHOR_WALLET=~/.config/solana/id.json
